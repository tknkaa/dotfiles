# Deployed by `stow git` from ~/dotfiles.
# Identity (user.name / user.email) lives in config.local, which is not tracked.
[include]
	path = config.local

[init]
	defaultBranch = main

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	side-by-side = true
	navigate = true

[merge]
	conflictStyle = zdiff3
