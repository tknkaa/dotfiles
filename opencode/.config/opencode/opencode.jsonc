{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/gpt-6-luna",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "external_directory": "allow"
  },
  "agent": {
    "judge": {
      "mode": "primary",
      "description": "bash コマンドが依頼に沿っているかを判定する(プラグイン専用)",
      "permission": { "*": "deny" }
    }
  }
}
